IMPLEMENTATION MODULE POS;

IMPORT IO;

(*------------------------------------------------------------------------------------------------------------------------------*)
(*$1*)
PROCEDURE IncCol(VAR Position : tPosition; n : SHORTINT);
BEGIN (* IncCol *)
 INC(Position.Column,n);
END IncCol;

(*------------------------------------------------------------------------------------------------------------------------------*)
(*$1*)
PROCEDURE Compare(VAR p, q : tPosition) : INTEGER;
BEGIN (* Compare *)
 IF    p.Line < q.Line THEN RETURN -1;
 ELSIF p.Line > q.Line THEN RETURN  1;
                       ELSE IF    p.Column < q.Column THEN RETURN -1;
                            ELSIF p.Column > q.Column THEN RETURN  1;
                                                      ELSE RETURN  0;
                            END; (* IF *)
 END; (* IF *)
END Compare;

(*------------------------------------------------------------------------------------------------------------------------------*)
(*$1*)
PROCEDURE WritePosition(f : IO.tFile; Position : tPosition);
BEGIN (* WritePosition *)
 IO.WriteI(f, Position.Line, 0); IO.WriteC(f, '.'); IO.WriteI(f, Position.Column, 0);
END WritePosition;

(*------------------------------------------------------------------------------------------------------------------------------*)
BEGIN (* POS *)
 NoPosition.Line   := 0;
 NoPosition.Column := 0;
END POS.

