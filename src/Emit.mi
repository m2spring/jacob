   CASE e^.gcg^.rule [ntBreg] OF 
   | 205 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[2]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
