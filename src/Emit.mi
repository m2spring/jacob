          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc        := AT0.Gv.loc;  
      resAttributes.Breg.loc.ofs    := AT0.Gv.loc.ofs+e^.son[2]^.son[2]^.gcg^.Constant.val; 
      resAttributes.Breg.loc.breg   := RegAlloc.allocation[ai].op[2]; 
    
   | 194 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtLReg(e^.son[2]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 194/2424 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' Index ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc        := AT0.Gv.loc;  
      resAttributes.Breg.loc.ofs    := AT0.Gv.loc.ofs+e^.son[2]^.son[1]^.gcg^.Constant.val; 
      resAttributes.Breg.loc.breg   := RegAlloc.allocation[ai].op[3]; 
    
   | 144 : 
  EmitNtaRetype(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 144/2187 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' Retype2Addr ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc          := ASM.mtLocation;
      resAttributes.Breg.loc.label    := LAB.MT; 
      resAttributes.Breg.loc.ofs      := e^.son[1]^.gcg^.aRetype.tmpOfs; 
      resAttributes.Breg.loc.breg     := Regebp; 
      resAttributes.Breg.loc.ireg     := RegNil; 
      resAttributes.Breg.loc.factor   := 1; 
      resAttributes.Breg.loc.cmtIdent := Idents.NoIdent; 
    
   | 38 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 38/1066 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' PointerFrom ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc        := ASM.mtLocation;
      resAttributes.Breg.loc.label  := LAB.MT; 
      resAttributes.Breg.loc.ofs    := 0; 
      resAttributes.Breg.loc.breg   := RegAlloc.allocation[ai].op[1];  
      resAttributes.Breg.loc.ireg   := RegNil; 
      resAttributes.Breg.loc.factor := 1; 
    
   | 32 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 32/1029 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' Index ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc        := AT0.Gv.loc;  
      resAttributes.Breg.loc.breg   := RegAlloc.allocation[ai].op[2]; 
    
   | 29 : 
  EmitNtBreg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 29/1016 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' Selector ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc:=AT0.Breg.loc; INC(resAttributes.Breg.loc.ofs,e^.attr^.Selector.ofs); 
    
   | 26 : 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 26/1000 Cost=');
          WriteInt    (e^.gcg^.cost [ntBreg],1);
          WriteString (' LocalVariable ->   Breg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Breg.loc          := ASM.mtLocation;
      resAttributes.Breg.loc.label    := LAB.MT; 
      resAttributes.Breg.loc.ofs      := e^.attr^.LocalVariable.adr; 
      resAttributes.Breg.loc.breg     := Regebp; 
      resAttributes.Breg.loc.ireg     := RegNil; 
      resAttributes.Breg.loc.factor   := 1; 
      resAttributes.Breg.loc.cmtIdent := e^.attr^.LocalVariable.cmtIdent; 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttrBreg (resAttributes);
       WriteLn;
   END;
END EmitNtBreg;

PROCEDURE EmitNtBregIreg (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntBregIreg] OF 
   | 212 : 
  EmitNtMemory(e^.son[1]^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[1]^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtLReg(e^.son[1]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 212/2599 Cost=');
          WriteInt    (e^.gcg^.cost [ntBregIreg],1);
          WriteString (' OpenIndexApplication ->   BregIreg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF ARG.OptionIndexChecking THEN 
         INC(AT0.Memory.loc.ofs,e^.son[1]^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
         ASM.CS2                                     ( cmp,l   ,  i(e^.son[1]^.son[1]^.son[2]^.gcg^.Constant.val),Loc(AT0.Memory.loc)                                           );
         ASM.C1                                      ( jbe     ,  L(LAB.IndexFault)                                             );
         DEC(AT0.Memory.loc.ofs,e^.son[1]^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
      END;

      resAttributes.BregIreg.loc        := ASM.mtLocation;
      resAttributes.BregIreg.loc.label  := LAB.MT; 
      resAttributes.BregIreg.loc.ofs    := e^.son[1]^.son[1]^.son[2]^.gcg^.Constant.val*e^.son[1]^.attr^.OpenIndexBase.staticSize; 
      resAttributes.BregIreg.loc.breg   := AT0.Memory.loc.breg; 
      resAttributes.BregIreg.loc.ireg   := RegNil; 
      resAttributes.BregIreg.loc.factor := 1;  

      IF e^.attr^.OpenIndexApplication.isStackObj THEN 
         IF resAttributes.BregIreg.loc.breg=ebp THEN resAttributes.BregIreg.loc.breg:=RegAlloc.allocation[ai].op[3]; END;
         ASM.CS2                                     ( mov,l   ,  oB(e^.attr^.OpenIndexApplication.objOfs,AT0.Memory.loc.breg),R(resAttributes.BregIreg.loc.breg) );
      ELSE 
         INC(resAttributes.BregIreg.loc.ofs,e^.attr^.OpenIndexApplication.objOfs); 
      END;
    
   | 211 : 
  EmitNtMemory(e^.son[1]^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[1]^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtLReg(e^.son[1]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 211/2568 Cost=');
          WriteInt    (e^.gcg^.cost [ntBregIreg],1);
          WriteString (' OpenIndexApplication ->   BregIreg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF ARG.OptionIndexChecking THEN 
         INC(AT0.Memory.loc.ofs,e^.son[1]^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
         ASM.CS2                                     ( cmp,l   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].op[2])                                               );
         ASM.C1                                      ( jae     ,  L(LAB.IndexFault)                                             );
         DEC(AT0.Memory.loc.ofs,e^.son[1]^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
      END;

      IF AT0.Memory.loc.ireg#RegNil THEN 
         ASM.CS2                                     ( lea,l   ,  Loc(AT0.Memory.loc),R(AT0.Memory.loc.breg)                                      ); 
      END;

      resAttributes.BregIreg.loc        := ASM.mtLocation;
      resAttributes.BregIreg.loc.label  := LAB.MT; 
      resAttributes.BregIreg.loc.ofs    := 0; 
      resAttributes.BregIreg.loc.breg   := AT0.Memory.loc.breg; 
      resAttributes.BregIreg.loc.ireg   := RegAlloc.allocation[ai].op[2]; 
      resAttributes.BregIreg.loc.factor := e^.son[1]^.attr^.OpenIndexBase.staticSize;  

