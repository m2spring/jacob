 resAttributes.Memory.loc:=ASM.mtLocation;  
      NDP.Save;
      INC(AT1.aArguments.paramSpace,8); 
      ASM.C1                                         ( pushl   ,  R(RegAlloc.allocation[ai].op[1])                                                          ); 
      ASM.CS2                                        ( mov,l   ,  oB(-4,RegAlloc.allocation[ai].op[1]),R(RegAlloc.allocation[ai].op[1])                                                 ); 
