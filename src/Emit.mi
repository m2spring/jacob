 CASE e^.attr^.ShortConstStrCopy.len OF
      |0: ASM.C1                                     ( popl    ,  R(ecx)                                                        );
          ASM.CS2                                    ( test,l  ,  R(ecx),R(ecx)                                                 );
          ASM.C1                                     ( jle     ,  L(LAB.New(label1))                                            );
          ASM.CS2                                    ( mov,b   ,  i(0),B(edi)                                                   );
          ASM.Label                          ( label1                                                                           );

      |1: ASM.C1                                     ( popl    ,  R(ecx)                                                        );
          ASM.CS2                                    ( cmp,l   ,  i(1),R(ecx)                                                   );
          ASM.C1                                     ( jl      ,  L(LAB.New(label2))                                            );
          ASM.C1                                     ( jz      ,  L(LAB.New(label1))                                            );
          ASM.CS2                                    ( mov,b   ,  i(e^.attr^.ShortConstStrCopy.strVal MOD 256),B(edi)                                   );
          ASM.CS1                                    ( inc,l   ,  R(edi)                                                        );
          ASM.Label                          ( label1                                                                           );
          ASM.CS2                                    ( mov,b   ,  i(0),B(edi)                                                   );
          ASM.Label                          ( label2                                                                           );
