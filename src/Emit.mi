PROCEDURE EmitNtGv (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntGv] OF 
   | 27 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 27/1010 Cost=');
          WriteInt    (e^.gcg^.cost [ntGv],1);
          WriteString (' Selector ->   Gv');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Gv.loc:=AT0.Gv.loc; INC(resAttributes.Gv.loc.ofs,e^.attr^.Selector.ofs); 
    
   | 25 : 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 25/991 Cost=');
          WriteInt    (e^.gcg^.cost [ntGv],1);
          WriteString (' GlobalVariable ->   Gv');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Gv.loc          := ASM.mtLocation;
      resAttributes.Gv.loc.label    := e^.attr^.GlobalVariable.label; 
      resAttributes.Gv.loc.ofs      := e^.attr^.GlobalVariable.adr; 
      resAttributes.Gv.loc.breg     := RegNil; 
      resAttributes.Gv.loc.ireg     := RegNil; 
      resAttributes.Gv.loc.factor   := 1; 
      resAttributes.Gv.loc.cmtIdent := e^.attr^.GlobalVariable.cmtIdent; 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttrGv (resAttributes);
       WriteLn;
   END;
END EmitNtGv;

PROCEDURE EmitNtIreg (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntIreg] OF 
   | 204 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[2]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 204/2488 Cost=');
          WriteInt    (e^.gcg^.cost [ntIreg],1);
          WriteString (' Index ->   Ireg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Ireg.loc        := AT0.Gv.loc; 	 
      resAttributes.Ireg.loc.ofs    := AT0.Gv.loc.ofs-e^.attr^.Index.factor*e^.son[2]^.son[2]^.gcg^.Constant.val; 
      resAttributes.Ireg.loc.ireg   := RegAlloc.allocation[ai].op[2];  
      resAttributes.Ireg.loc.factor := e^.attr^.Index.factor; 
    
   | 193 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[2]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 193/2412 Cost=');
          WriteInt    (e^.gcg^.cost [ntIreg],1);
          WriteString (' Index ->   Ireg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Ireg.loc        := AT0.Gv.loc; 	 
      resAttributes.Ireg.loc.ofs    := AT0.Gv.loc.ofs+e^.attr^.Index.factor*e^.son[2]^.son[2]^.gcg^.Constant.val; 
      resAttributes.Ireg.loc.ireg   := RegAlloc.allocation[ai].op[2];  
      resAttributes.Ireg.loc.factor := e^.attr^.Index.factor; 
    
   | 192 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtLReg(e^.son[2]^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 192/2412 Cost=');
          WriteInt    (e^.gcg^.cost [ntIreg],1);
          WriteString (' Index ->   Ireg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Ireg.loc        := AT0.Gv.loc; 	 
      resAttributes.Ireg.loc.ofs    := AT0.Gv.loc.ofs+e^.attr^.Index.factor*e^.son[2]^.son[1]^.gcg^.Constant.val; 
      resAttributes.Ireg.loc.ireg   := RegAlloc.allocation[ai].op[3];  
      resAttributes.Ireg.loc.factor := e^.attr^.Index.factor; 
    
   | 31 : 
  EmitNtGv(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 31/1023 Cost=');
          WriteInt    (e^.gcg^.cost [ntIreg],1);
          WriteString (' Index ->   Ireg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Ireg.loc        := AT0.Gv.loc; 
      resAttributes.Ireg.loc.ireg   := RegAlloc.allocation[ai].op[2];  
      resAttributes.Ireg.loc.factor := e^.attr^.Index.factor; 
    
   | 28 : 
  EmitNtIreg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 28/1013 Cost=');
          WriteInt    (e^.gcg^.cost [ntIreg],1);
          WriteString (' Selector ->   Ireg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Ireg.loc:=AT0.Ireg.loc; INC(resAttributes.Ireg.loc.ofs,e^.attr^.Selector.ofs); 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttrIreg (resAttributes);
       WriteLn;
   END;
END EmitNtIreg;

PROCEDURE EmitNtBreg (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
