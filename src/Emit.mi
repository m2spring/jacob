         ASM.C1                                      ( ja      ,  L(LAB.ElementFault)                                           );
      END;
      ASM.CS2                                        ( bts,l   ,  R(RegAlloc.allocation[1].op[2]),Loc(AT0.Memory.loc)                                               ); 
    
     | 129 :
