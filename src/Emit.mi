 ASM.C1                                         ( pushl   ,  iL(e^.attr^.StaticNew.initLabel)                                              );
      ASM.C1                                         ( pushl   ,  iL(e^.attr^.StaticNew.tdescLabel)                                             );
      ASM.C1                                         ( pushl   ,  i(e^.attr^.StaticNew.size)                                                    );
      ASM.CS2                                        ( lea,l   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[1].scr[1])                                               );
      ASM.C1                                         ( pushl   ,  R(RegAlloc.allocation[1].scr[1])                                                          );
