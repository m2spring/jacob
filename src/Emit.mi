 ASM.CS2( xor,b  ,  R(bh),R(bh)      ); 
   | 275 : 
  EmitNtBReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 275/3274 Cost=');
