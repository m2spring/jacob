          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.Memory.loc:=ASM.mtLocation;  
      NDP.Save;
      INC(AT1.aArguments.paramSpace,4); 
      ASM.C1                                         ( pushl   ,  R(RegAlloc.allocation[ai].op[1])                                                          ); 
      IF e^.attr^.BoundCall_FRec_ARec.bprocLab=LAB.MT THEN 
         ASM.CS2                                     ( mov,l   ,  oB(e^.attr^.BoundCall_FRec_ARec.procOfs,RegAlloc.allocation[ai].op[1]),R(RegAlloc.allocation[ai].op[1])                                         );
         ASM.C1                                      ( call    ,  R(RegAlloc.allocation[ai].op[1])                                                          ); 
      ELSE 
         ASM.C1                                      ( call    ,  L(e^.attr^.BoundCall_FRec_ARec.bprocLab)                                                );
      END;
      IF AT1.aArguments.paramSpace#0 THEN ASM.CS2               ( add,l   ,  i(AT1.aArguments.paramSpace),R(esp)                                      ); 
      END; 
    
   | 68 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
  EmitNtaArguments(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
