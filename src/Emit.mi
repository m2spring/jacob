         ASM.C1                                      ( jle     ,  L(LAB.DivFault)                                               );
      END;
      ASM.C0                                         ( cbw                                                                      ); 
      ASM.CS1                                        ( idiv,b  ,  R(RegAlloc.allocation[ai].op[2])                                                         ); 
      ASM.CS2                                        ( test,b  ,  R(ah),R(ah)                                                   ); 
      ASM.C1                                         ( jge     ,  L(LAB.New(label))                                             );
      ASM.CS1                                        ( dec,b   ,  R(al)                                                         );
      ASM.Label                               ( label                                                                           ); 
    
   | 75 : 
  EmitNtMemory(e^.son[1],nest+1,AT0 ); 
