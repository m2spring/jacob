PROCEDURE EmitNtaOpenIndexedElem (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaOpenIndexedElem] OF 
   | 210 : 
  EmitNtMemory(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtLReg(e^.son[2],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 210/2550 Cost=');
          WriteInt    (e^.gcg^.cost [ntaOpenIndexedElem],1);
          WriteString (' OpenIndexBase ->   aOpenIndexedElem');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aOpenIndexedElem.headerBaseReg   := RegAlloc.allocation[ai].op[3]; 
      resAttributes.aOpenIndexedElem.displacementReg := RegAlloc.allocation[ai].op[2]; 

      IF ARG.OptionIndexChecking THEN 
         INC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
         ASM.CS2                                     ( cmp,l   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].op[2])                                               );
         ASM.C1                                      ( jae     ,  L(LAB.IndexFault)                                             );
         DEC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.OpenIndexFirst.lenOfs); 
      END;

      ASM.CS2                                        ( imul,l  ,  i(e^.attr^.OpenIndexBase.staticSize),R(RegAlloc.allocation[ai].op[2])                                        ); 
      ASM.CS2                                        ( lea,l   ,  Loc(AT0.Memory.loc),R(resAttributes.aOpenIndexedElem.headerBaseReg)                               );
    
   | 42 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 42/1111 Cost=');
          WriteInt    (e^.gcg^.cost [ntaOpenIndexedElem],1);
          WriteString (' OpenIndexBase ->   aOpenIndexedElem');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aOpenIndexedElem.headerBaseReg   := RegAlloc.allocation[ai].op[2]; 
      resAttributes.aOpenIndexedElem.displacementReg := RegAlloc.allocation[ai].op[1]; 

      ASM.CS2                                        ( imul,l  ,  i(e^.attr^.OpenIndexBase.staticSize),R(RegAlloc.allocation[ai].op[1])                                     ); 
      ASM.CS2                                        ( mov,l   ,  oB(e^.attr^.OpenIndexBase.tmpOfs,ebp),R(resAttributes.aOpenIndexedElem.headerBaseReg)                        ); 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraOpenIndexedElem (resAttributes);
       WriteLn;
   END;
END EmitNtaOpenIndexedElem;

PROCEDURE EmitNtaStrCopyArgs (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaStrCopyArgs] OF 
   | 246 : 
  EmitNtMemory(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 246/3126 Cost=');
          WriteInt    (e^.gcg^.cost [ntaStrCopyArgs],1);
          WriteString (' StrCopyArguments ->   aStrCopyArgs');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 INC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.lenOfs);
      ASM.CS2                                        ( mov,l   ,  Loc(AT0.Memory.loc),R(ecx)                                           ); 
      ASM.CS2                                        ( cmp,l   ,  i(e^.son[2]^.attr^.ImplicifyConst.len),R(ecx)                                               ); 
      ASM.C1                                         ( jle     ,  L(LAB.New(label))                                             );
      ASM.CS2                                        ( mov,l   ,  i(e^.son[2]^.attr^.ImplicifyConst.len),R(ecx)                                               ); 
      ASM.Label                               ( label                                                                           );                      
      DEC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.lenOfs);

      INC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.objOfs);
      IF e^.son[1]^.attr^.Implicify.isStackObject THEN
         ASM.CS2                                     ( mov,l   ,  Loc(AT0.Memory.loc),R(esi)                                           );
      ELSE
         ASM.CS2                                     ( lea,l   ,  Loc(AT0.Memory.loc),R(esi)                                           );
      END;
      
      ASM.CS2                                        ( lea,l   ,  Loc(AT1.Memory.loc),R(edi)                                           );
    
   | 245 : 
  EmitNtMemory(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 245/3104 Cost=');
          WriteInt    (e^.gcg^.cost [ntaStrCopyArgs],1);
          WriteString (' StrCopyArguments ->   aStrCopyArgs');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 INC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.lenOfs);
      ASM.CS2                                        ( mov,l   ,  Loc(AT1.Memory.loc),R(ecx)                                           ); 
      ASM.CS2                                        ( cmp,l   ,  i(e^.son[1]^.attr^.ImplicifyConst.len),R(ecx)                                               ); 
      ASM.C1                                         ( jle     ,  L(LAB.New(label))                                             );
      ASM.CS2                                        ( mov,l   ,  i(e^.son[1]^.attr^.ImplicifyConst.len),R(ecx)                                               ); 
      ASM.Label                               ( label                                                                           );                      
      DEC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.lenOfs);

      ASM.CS2                                        ( lea,l   ,  Loc(AT0.Memory.loc),R(esi)                                           );
      
      INC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.objOfs);
      IF e^.son[2]^.attr^.Implicify.isStackObject THEN
         ASM.CS2                                     ( mov,l   ,  Loc(AT1.Memory.loc),R(edi)                                           );
      ELSE
         ASM.CS2                                     ( lea,l   ,  Loc(AT1.Memory.loc),R(edi)                                           );
      END;
    
   | 244 : 
  EmitNtMemory(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 244/3074 Cost=');
          WriteInt    (e^.gcg^.cost [ntaStrCopyArgs],1);
          WriteString (' StrCopyArguments ->   aStrCopyArgs');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 INC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.lenOfs);
      ASM.CS2                                        ( mov,l   ,  Loc(AT0.Memory.loc),R(ecx)                                           ); 
      DEC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.lenOfs);

      INC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.lenOfs);
      ASM.CS2                                        ( cmp,l   ,  Loc(AT1.Memory.loc),R(ecx)                                           ); 
      ASM.C1                                         ( jle     ,  L(LAB.New(label1))                                            );
      ASM.CS2                                        ( mov,l   ,  Loc(AT1.Memory.loc),R(ecx)                                           ); 
      ASM.Label                              ( label1                                                                           );                      
      DEC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.lenOfs);

      INC(AT0.Memory.loc.ofs,e^.son[1]^.attr^.Implicify.objOfs);
      IF e^.son[1]^.attr^.Implicify.isStackObject THEN
         ASM.CS2                                     ( mov,l   ,  Loc(AT0.Memory.loc),R(esi)                                           );
      ELSE
         ASM.CS2                                     ( lea,l   ,  Loc(AT0.Memory.loc),R(esi)                                           );
      END;
      
      INC(AT1.Memory.loc.ofs,e^.son[2]^.attr^.Implicify.objOfs);
      IF e^.son[2]^.attr^.Implicify.isStackObject THEN
         ASM.CS2                                     ( mov,l   ,  Loc(AT1.Memory.loc),R(edi)                                           );
      ELSE
         ASM.CS2                                     ( lea,l   ,  Loc(AT1.Memory.loc),R(edi)                                           );
      END;
    
   | 116 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 116/1803 Cost=');
          WriteInt    (e^.gcg^.cost [ntaStrCopyArgs],1);
          WriteString (' StrCopyArguments ->   aStrCopyArgs');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.C1                                         ( popl    ,  R(ecx)                                                        );
      ASM.CS2                                        ( cmp,l   ,  B(esp),R(ecx)                                                 );
      ASM.C1                                         ( jle     ,  L(LAB.New(label1))                                            );
      ASM.CS2                                        ( mov,l   ,  B(esp),R(ecx)                                                 );
      ASM.Label                              ( label1                                                                           );
      ASM.CS2                                        ( add,l   ,  i(4),R(esp)                                                   ); 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraStrCopyArgs (resAttributes);
       WriteLn;
   END;
END EmitNtaStrCopyArgs;

PROCEDURE EmitNtaArguments (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaArguments] OF 
   | 328 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtFloat(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 328/3509 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' FloatParam ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+ASM.FloatByteSizeTab[e^.attr^.FloatParam.size]; 
      ASM.CS2                                        ( sub,l         ,  i(ASM.FloatByteSizeTab[e^.attr^.FloatParam.size]),R(esp)                 );
      NDP.CS1                                        ( fstp,e^.attr^.FloatParam.size  ,  B(esp)                                                  );
    
   | 215 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2]^.son[1]^.son[1]^.son[1]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 215/2646 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+4; 
      ASM.C1                                         ( pushl   ,  Loc(AT1.Memory.loc)                                                    );
    
   | 214 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2]^.son[1]^.son[1]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 214/2635 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+4; 
      ASM.C1                                         ( pushl   ,  Loc(AT1.Memory.loc)                                                    );
    
   | 213 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtGv(e^.son[2]^.son[1],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 213/2627 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+4; 
      ASM.C1                                         ( pushl   ,  ioL(AT1.Gv.loc.ofs,AT1.Gv.loc.label)                                    );
    
   | 64 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtaOpenIndexedElem(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 64/1321 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param_PartialOArrSizeAndAddr ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+8; 
      IF e^.attr^.Param_PartialOArrSizeAndAddr.nofUnindexedLens>0 THEN 
         ASM.CS3                                     ( imul,l  ,  i(e^.attr^.Param_PartialOArrSizeAndAddr.staticSize),oB(e^.attr^.Param_PartialOArrSizeAndAddr.ofsOfLastLen,AT1.aOpenIndexedElem.headerBaseReg),R(RegAlloc.allocation[ai].scr[1])   ); 
         FOR ii:=1 TO e^.attr^.Param_PartialOArrSizeAndAddr.nofUnindexedLens-1 DO
          ASM.CS2                                    ( imul,l  ,  oB(e^.attr^.Param_PartialOArrSizeAndAddr.ofsOfLastLen-4*ii,AT1.aOpenIndexedElem.headerBaseReg),R(RegAlloc.allocation[ai].scr[1])               ); 
         END;
         ASM.C1                                      ( pushl   ,  R(RegAlloc.allocation[ai].scr[1])                                                        );
      ELSE 
         ASM.C1                                      ( pushl   ,  i(e^.attr^.Param_PartialOArrSizeAndAddr.staticSize)                                              );
      END;

      reg:=AT1.aOpenIndexedElem.displacementReg; 
      IF e^.attr^.Param_PartialOArrSizeAndAddr.isStackObj THEN 
         ASM.CS2                                     ( add,l   ,  oB(e^.attr^.Param_PartialOArrSizeAndAddr.objOfs,AT1.aOpenIndexedElem.headerBaseReg),R(reg)                          );
      ELSE 
         ASM.CS2                                     ( lea,l   ,  oBI(e^.attr^.Param_PartialOArrSizeAndAddr.objOfs,AT1.aOpenIndexedElem.headerBaseReg,reg),R(reg)                     );
      END;
      ASM.C1                                         ( pushl   ,  R(reg)                                                        ); 
    
   | 63 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 63/1308 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param_OArrSizeAndAddr ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+8; 
      reg:=ASM.SizedRegTab[RegAlloc.allocation[ai].op[2],l]; 
      IF e^.attr^.Param_OArrSizeAndAddr.elemSize=1 THEN 
         ASM.C1                                      ( pushl   ,  B(reg)                                                        );
      ELSE 
         ASM.CS3                                     ( imul,l  ,  i(e^.attr^.Param_OArrSizeAndAddr.elemSize),B(RegAlloc.allocation[ai].op[2]),R(RegAlloc.allocation[ai].scr[1])                                    );
         ASM.C1                                      ( pushl   ,  R(RegAlloc.allocation[ai].scr[1])                                                        );
      END;
      ASM.CS2                                        ( lea,l   ,  oB(e^.attr^.Param_OArrSizeAndAddr.objOfs,reg),R(reg)                                      ); 
      ASM.C1                                         ( pushl   ,  R(reg)                                                        ); 
    
   | 62 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 62/1300 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param_RecordSizeAndAddr ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+8; 
      reg:=ASM.SizedRegTab[RegAlloc.allocation[ai].op[2],l]; 
      ASM.CS2                                        ( mov,l   ,  oB(-4,reg),R(RegAlloc.allocation[ai].scr[1])                                             ); 
      ASM.C1                                         ( pushl   ,  oB(-8,RegAlloc.allocation[ai].scr[1])                                                    );
      ASM.C1                                         ( pushl   ,  R(reg)                                                        ); 
    
   | 61 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtaImplicits(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 61/1296 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param_Implicit ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT1.aImplicits.a.paramSpace; 
    
   | 53 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtMemory(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 53/1179 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' ParamStructured ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 len:=ADR.Align4(e^.attr^.ParamStructured.size); 
      resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+len; 
      ASM.CS2                                        ( sub,l   ,  i(len),R(esp)                                                 );
(*
      ASM.MemCopy(Loc(AT1.Memory.loc),B(esp),tmp,e^.attr^.ParamStructured.size,(*isStringCopy:=*)FALSE);       
*)      
      ASM.MemCopy(Loc(AT1.Memory.loc),B(esp),e^.attr^.ParamStructured.size,(*isStringCopy:=*)FALSE);       
    
   | 52 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 52/1175 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param0 ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 reg:=RegAlloc.allocation[ai].op[2]; 
      resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace; 
    
   | 51 : 
  EmitNtaArguments(e^.son[1],nest+1,AT0 ); 
  EmitNtAMemARegAImm(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 51/1166 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' Param ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=AT0.aArguments.paramSpace+4; 
      IF AT1.AMemARegAImm.oper.kind=ASM.okRegister THEN 
         ASM.C1                                      ( pushl   ,  R(ASM.SizedRegTab[AT1.AMemARegAImm.oper.reg,l])                              );
      ELSE 
         ASM.C1                                      ( pushl   ,  Operand(AT1.AMemARegAImm.oper)                                               );
      END; 
    
   | 50 : 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 50/1163 Cost=');
          WriteInt    (e^.gcg^.cost [ntaArguments],1);
          WriteString (' NoParam ->   aArguments');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aArguments.paramSpace:=0; 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraArguments (resAttributes);
       WriteLn;
   END;
END EmitNtaArguments;

PROCEDURE EmitNtaImplicits (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaImplicits] OF 
   | 60 : 
  EmitNtaImplicits(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 60/1289 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplTypedesc ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aImplicits.a:=AT0.aImplicits.a; 
      INC(resAttributes.aImplicits.a.paramSpace,4); 

      INC(AT0.aImplicits.a.headerloc.ofs,AT0.aImplicits.a.objOfs-4); 
      ASM.C1                                         ( pushl   ,  Loc(AT0.aImplicits.a.headerloc)                                           );
    
   | 59 : 
  EmitNtaImplicits(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 59/1257 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplObjReference ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aImplicits.a:=AT0.aImplicits.a; 
      INC(resAttributes.aImplicits.a.paramSpace,4); 
      reg:=AT0.aImplicits.a.nofElemsReg; 

      INC(AT0.aImplicits.a.headerloc.ofs,AT0.aImplicits.a.objOfs); 
      IF AT0.aImplicits.a.isStackObj THEN 
         IF AT0.aImplicits.a.displacementReg=RegNil THEN 
            ASM.C1                                   ( pushl   ,  Loc(AT0.aImplicits.a.headerloc)                                           );
         ELSE 
            ASM.CS2                                  ( add,l   ,  Loc(AT0.aImplicits.a.headerloc),R(AT0.aImplicits.a.displacementReg)                   ); 
            ASM.C1                                   ( pushl   ,  R(AT0.aImplicits.a.displacementReg)                                       );
         END;
      ELSE 
         IF AT0.aImplicits.a.displacementReg=RegNil THEN 
            IF ASM.IsBaseAdrmode(AT0.aImplicits.a.headerloc) THEN
               ASM.C1                                ( pushl   ,  R(AT0.aImplicits.a.headerloc.breg)                                        );
            ELSE 
               ASM.CS2                               ( lea,l   ,  Loc(AT0.aImplicits.a.headerloc),R(reg)                                    ); 
               ASM.C1                                ( pushl   ,  R(reg)                                                        );
            END;
         ELSE  
            IF ASM.IsBaseAdrmode(AT0.aImplicits.a.headerloc) THEN
               reg:=AT0.aImplicits.a.headerloc.breg;
            ELSE 
               ASM.CS2                               ( lea,l   ,  Loc(AT0.aImplicits.a.headerloc),R(reg)                                    ); 
            END;
            ASM.CS2                                  ( add,l   ,  R(reg),R(AT0.aImplicits.a.displacementReg)                                ); 
            ASM.C1                                   ( pushl   ,  R(AT0.aImplicits.a.displacementReg)                                       );
         END;
      END; 
    
   | 58 : 
  EmitNtaImplicits(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 58/1234 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplNewNofElems ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aImplicits.a:=AT0.aImplicits.a; 
      IF AT0.aImplicits.a.nofConstLens+AT0.aImplicits.a.nofOpenLens>1 THEN 
         INC(resAttributes.aImplicits.a.paramSpace,4); 
         IF AT0.aImplicits.a.nofOpenLens=0 THEN 
            ASM.C1                                   ( pushl   ,  i(AT0.aImplicits.a.baseNofElems)                                          );
         ELSE 
            INC(AT0.aImplicits.a.headerloc.ofs,AT0.aImplicits.a.implOfs);
            IF e^.attr^.ImplNewNofElems.useActNofElems THEN 
               ASM.C1                                ( pushl   ,  Loc(AT0.aImplicits.a.headerloc)                                           ); 
            ELSE 
               INC(AT0.aImplicits.a.headerloc.ofs,4*AT0.aImplicits.a.nofOpenLens); 
               ASM.CS3                               ( imul,l  ,  i(AT0.aImplicits.a.baseNofElems),Loc(AT0.aImplicits.a.headerloc),R(AT0.aImplicits.a.nofElemsReg)  );
               DEC(AT0.aImplicits.a.headerloc.ofs,4); 
               FOR ii:=2 TO AT0.aImplicits.a.nofOpenLens DO
                ASM.CS2                              ( imul,l  ,  Loc(AT0.aImplicits.a.headerloc),R(AT0.aImplicits.a.nofElemsReg)                       );
                DEC(AT0.aImplicits.a.headerloc.ofs,4); 
               END;
               ASM.C1                                ( pushl   ,  R(AT0.aImplicits.a.nofElemsReg)                                           );
            END;
         END;
      END;     
    
   | 57 : 
  EmitNtaImplicits(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 57/1225 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplOpenLen ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 INC(AT0.aImplicits.a.nofOpenLens); 
      resAttributes.aImplicits.a                 := AT0.aImplicits.a; 
      resAttributes.aImplicits.a.implOfs         := AT0.aImplicits.a.implOfs-4; 
      INC(resAttributes.aImplicits.a.paramSpace,4); 

      INC(AT0.aImplicits.a.headerloc.ofs,AT0.aImplicits.a.implOfs);
      ASM.C1                                         ( pushl   ,  Loc(AT0.aImplicits.a.headerloc)                                           ); 
    
   | 56 : 
  EmitNtaImplicits(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 56/1217 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplConstLen ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 INC(AT0.aImplicits.a.nofConstLens); 
      resAttributes.aImplicits.a                 := AT0.aImplicits.a; 
      resAttributes.aImplicits.a.baseNofElems    := e^.attr^.ImplConstLen.len*AT0.aImplicits.a.baseNofElems; 
      INC(resAttributes.aImplicits.a.paramSpace,4); 

      ASM.C1                                         ( pushl   ,  i(e^.attr^.ImplConstLen.len)                                                     );
    
   | 55 : 
  EmitNtaOpenIndexedElem(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 55/1204 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplicitOpenIndexedArg ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aImplicits.a.headerloc       := ASM.mtLocation;
      resAttributes.aImplicits.a.headerloc.breg  := AT0.aOpenIndexedElem.headerBaseReg; 
      resAttributes.aImplicits.a.displacementReg := AT0.aOpenIndexedElem.displacementReg; 
      resAttributes.aImplicits.a.nofElemsReg     := RegAlloc.allocation[ai].op[2]; 
      resAttributes.aImplicits.a.implOfs         := e^.attr^.ImplicitOpenIndexedArg.implOfs;
      resAttributes.aImplicits.a.baseNofElems    := 1; 
      resAttributes.aImplicits.a.nofConstLens    := 0;
      resAttributes.aImplicits.a.nofOpenLens     := 0; 
      resAttributes.aImplicits.a.objOfs          := e^.attr^.ImplicitOpenIndexedArg.objOfs; 
      resAttributes.aImplicits.a.isStackObj      := e^.attr^.ImplicitOpenIndexedArg.isStackObj; 
      resAttributes.aImplicits.a.paramSpace      := 0; 
    
   | 54 : 
  EmitNtMemory(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 54/1192 Cost=');
          WriteInt    (e^.gcg^.cost [ntaImplicits],1);
          WriteString (' ImplicitArg ->   aImplicits');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 resAttributes.aImplicits.a.headerloc       := AT0.Memory.loc; 
      resAttributes.aImplicits.a.displacementReg := RegNil; 
      resAttributes.aImplicits.a.nofElemsReg     := RegAlloc.allocation[ai].op[2]; 
      resAttributes.aImplicits.a.implOfs         := e^.attr^.ImplicitArg.implOfs; 
      resAttributes.aImplicits.a.baseNofElems    := 1; 
      resAttributes.aImplicits.a.nofConstLens    := 0;
      resAttributes.aImplicits.a.nofOpenLens     := 0; 
      resAttributes.aImplicits.a.objOfs          := e^.attr^.ImplicitArg.objOfs; 
      resAttributes.aImplicits.a.isStackObj      := e^.attr^.ImplicitArg.isStackObj; 
      resAttributes.aImplicits.a.paramSpace      := 0; 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraImplicits (resAttributes);
       WriteLn;
   END;
END EmitNtaImplicits;

PROCEDURE EmitNtaRetype (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaRetype] OF 
   | 139 : 
  EmitNtMemory(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 139/2155 Cost=');
          WriteInt    (e^.gcg^.cost [ntaRetype],1);
          WriteString (' Addr2Retype ->   aRetype');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 
(*
      ASM.MemCopy(Loc(AT0.Memory.loc),oB(e^.attr^.Addr2Retype.tmpOfs,ebp),RegAlloc.allocation[ai].scr[1],e^.attr^.Addr2Retype.srcLen,(*isStringCopy:=*)FALSE); 
*)
      ASM.MemCopy(Loc(AT0.Memory.loc),oB(e^.attr^.Addr2Retype.tmpOfs,ebp),e^.attr^.Addr2Retype.srcLen,(*isStringCopy:=*)FALSE); 

      ASM.FillZ(oB(e^.attr^.Addr2Retype.tmpOfs+e^.attr^.Addr2Retype.srcLen,ebp),RegAlloc.allocation[ai].scr[1],e^.attr^.Addr2Retype.dstLen-e^.attr^.Addr2Retype.srcLen); 
    
   | 138 : 
  EmitNtFloat(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 138/2146 Cost=');
          WriteInt    (e^.gcg^.cost [ntaRetype],1);
          WriteString (' Data2Retype ->   aRetype');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 NDP.CS1                                        ( fstp,ASM.FloatSizeTab[e^.attr^.Data2Retype.srcLen]  ,  oB(e^.attr^.Data2Retype.tmpOfs,ebp)                   ); 

      ASM.FillZ(oB(e^.attr^.Data2Retype.tmpOfs+e^.attr^.Data2Retype.srcLen,ebp),RegAlloc.allocation[ai].scr[1],e^.attr^.Data2Retype.dstLen-e^.attr^.Data2Retype.srcLen); 
    
   | 137 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 137/2136 Cost=');
          WriteInt    (e^.gcg^.cost [ntaRetype],1);
          WriteString (' Data2Retype ->   aRetype');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( mov,e^.son[1]^.gcg^.Reg.size  ,  R(RegAlloc.allocation[ai].op[1]),oB(e^.attr^.Data2Retype.tmpOfs,ebp)                                    ); 

      len:=ASM.ByteSizeTab[e^.son[1]^.gcg^.Reg.size]; 
      ASM.FillZ(oB(e^.attr^.Data2Retype.tmpOfs+len,ebp),RegAlloc.allocation[ai].scr[1],e^.attr^.Data2Retype.dstLen-len); 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraRetype (resAttributes);
       WriteLn;
   END;
END EmitNtaRetype;

