 resAttributes.Memory.loc:=ASM.mtLocation;  
      NDP.Save;
      INC(AT1.aArguments.paramSpace,4); 
      ASM.C1                                         ( pushl   ,  R(RegAlloc.allocation[ai].op[1])                                                          ); 
