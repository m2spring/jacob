       END;
 ASM.CS2( xor,b  ,  R(ah),R(ah)      ); 
   | 259 : 
  EmitNtBReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
