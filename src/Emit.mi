       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 259/3243 Cost=');
          WriteInt    (e^.gcg^.cost [ntWReg],1);
          WriteString (' Int2Integer ->   WReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.C0                                         ( cbw                                                                      );
    
   | 255 : 
  EmitNtMemory(e^.son[1]^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 255/3207 Cost=');
          WriteInt    (e^.gcg^.cost [ntWReg],1);
          WriteString (' Retype2Data ->   WReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[1]^.attr^.Addr2Retype.srcLen=0 THEN
         ASM.CS2                                     ( xor,w   ,  R(RegAlloc.allocation[ai].reg),R(RegAlloc.allocation[ai].reg)                                                 ); 
      ELSIF e^.son[1]^.attr^.Addr2Retype.srcLen=1 THEN
         ASM.C2                                      ( movzbw  ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].reg)                                           ); 
      ELSE 
         ASM.CS2                                     ( mov,w   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].reg)                                           ); 
      END;
    
   | 252 : 
  EmitNtReg(e^.son[1]^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 252/3195 Cost=');
          WriteInt    (e^.gcg^.cost [ntWReg],1);
          WriteString (' Retype2Data ->   WReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.RegCopy(RegAlloc.allocation[ai].op[1],RegAlloc.allocation[ai].reg); 
   | 222 : 
  EmitNtWReg(e^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 222/2750 Cost=');
          WriteInt    (e^.gcg^.cost [ntWReg],1);
          WriteString (' Mod ->   WReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[2]^.gcg^.Constant.val=1 THEN 
         ASM.CS2                                     ( xor,w   ,  R(dx),R(dx)                                                   ); 
      ELSIF ADR.IntLog2(e^.son[2]^.gcg^.Constant.val,shift) THEN
         ASM.CS2                                     ( mov,w   ,  R(ax),R(dx)                                                   ); 
         ASM.CS2                                     ( and,w   ,  i(e^.son[2]^.gcg^.Constant.val-1),R(dx)                                             ); 
      ELSE 
         ASM.CS2                                     ( mov,w   ,  i(e^.son[2]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].scr[1])                                              ); 
         ASM.C0                                      ( cwd                                                                      ); 
         ASM.CS1                                     ( idiv,w  ,  R(RegAlloc.allocation[ai].scr[1])                                                        ); 
         ASM.CS2                                     ( test,w  ,  R(dx),R(dx)                                                   ); 
         ASM.C1                                      ( jge     ,  L(LAB.New(label))                                             );
         ASM.CS2                                     ( add,w   ,  i(e^.son[2]^.gcg^.Constant.val),R(dx)                                               );
         ASM.Label                            ( label                                                                           ); 
      END;
    
   | 219 : 
  EmitNtWReg(e^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 219/2695 Cost=');
          WriteInt    (e^.gcg^.cost [ntWReg],1);
          WriteString (' Div ->   WReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[2]^.gcg^.Constant.val=1 THEN                               (*nop                                                                      *)
      ELSIF ADR.IntLog2(e^.son[2]^.gcg^.Constant.val,shift) THEN
         ASM.CS2                                     ( sar,w   ,  i(shift),R(RegAlloc.allocation[ai].op[1])                                                ); 
      ELSE 
         ASM.CS2                                     ( mov,w   ,  i(e^.son[2]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].scr[1])                                              ); 
         ASM.C0                                      ( cwd                                                                      ); 
         ASM.CS1                                     ( idiv,w  ,  R(RegAlloc.allocation[ai].scr[1])                                                        ); 
         ASM.CS2                                     ( test,w  ,  R(dx),R(dx)                                                   );
         ASM.C1                                      ( jge     ,  L(LAB.New(label))                                             );
         (* Hand-patched: Beg's generated output paired dec with the
            byte size (b) against the word register R(ax), producing
            invalid `decb %ax'; the rest of this rule (mov/idiv/test)
            is consistently word-sized (w), and R(ax) is a word
            register, so w is the size that actually matches. Beg
            itself can't be re-run to regenerate this correctly (see
            README Prerequisites), so this is a direct, minimal patch
            to the committed generated source. *)
         ASM.CS1                                     ( dec,w   ,  R(ax)                                                         );
         ASM.Label                            ( label                                                                           );
      END;

   | 172 :
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
