         ASM.CS2                                     ( cmp,l   ,  i(31),R(RegAlloc.allocation[1].op[2])                                                    );
         ASM.C1                                      ( ja      ,  L(LAB.ElementFault)                                           );
      END;
      ASM.CS2                                        ( btr,l   ,  R(RegAlloc.allocation[1].op[2]),Loc(AT0.Memory.loc)                                               ); 
    
