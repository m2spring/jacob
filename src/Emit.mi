     | 133 :
  EmitNtMemory(e^.son[1],nest+1,AT0 ); 
    IF (RegAlloc.allocation [1]. num>0) THEN 
       PerformActions (1);
    END;
    IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteString ('Rule 133/1963 Cost=');
       WriteInt    (e^.gcg^.stmtcost,1);
       WriteString (' Getreg');
       WriteLn;
       WriteNest (nest); 
       IF e#NIL THEN IR.PrintAttributes (e^.attr^); END; WriteLn; 
       WriteNest (nest); 
       RegAlloc.PrintAllocation (1); WriteLn;
    END;
 IF (MIN(ASM.CodeRegTabRange)<=e^.attr^.Getreg.regcoding) & (e^.attr^.Getreg.regcoding<=MAX(ASM.CodeRegTabRange)) THEN
         IF e^.attr^.Getreg.dstSize>4 THEN
            sz:=l;
         ELSE 
            sz:=ASM.SizeTab[e^.attr^.Getreg.dstSize]; 
         END;
         reg:=ASM.CodeRegTab[e^.attr^.Getreg.regcoding]; 
      END;

      CASE e^.attr^.Getreg.regcoding OF

      |ASM.codeEAX..ASM.codeEDX: 
         ASM.CS2                                     ( mov,sz  ,  R(ASM.SizedRegTab[reg,sz]),Loc(AT0.Memory.loc)                         );    

      |ASM.codeESI,ASM.codeEDI:
         IF sz=b THEN
            ASM.CS2                                  ( mov,l   ,  R(reg),R(RegAlloc.allocation[1].scr[1])                                                 ); 
            ASM.CS2                                  ( mov,b   ,  R(ASM.SizedRegTab[RegAlloc.allocation[1].scr[1],b]),Loc(AT0.Memory.loc)                          );    
         ELSE 
            ASM.CS2                                  ( mov,sz  ,  R(ASM.SizedRegTab[reg,sz]),Loc(AT0.Memory.loc)                         );    
         END;

      |ASM.codeEBP,ASM.codeESP:
         IF sz#l THEN
            ASM.CS2                                  ( mov,l   ,  R(reg),R(RegAlloc.allocation[1].scr[1])                                                 ); 
            ASM.CS2                                  ( mov,sz  ,  R(ASM.SizedRegTab[RegAlloc.allocation[1].scr[1],sz]),Loc(AT0.Memory.loc)                         );    
         ELSE 
            ASM.CS2                                  ( mov,l   ,  R(reg),Loc(AT0.Memory.loc)                                             );    
         END;

      |ASM.codeEFLAGS: 
         ASM.C0                                      ( pushf                                                                    );
         ASM.C1                                      ( popl    ,  R(RegAlloc.allocation[1].scr[1])                                                        );
         ASM.CS2                                     ( mov,sz  ,  R(ASM.SizedRegTab[RegAlloc.allocation[1].scr[1],sz]),Loc(AT0.Memory.loc)                         );    

      |ASM.codeST0..ASM.codeST7:
         IF reg#st THEN
