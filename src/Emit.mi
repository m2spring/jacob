 sz:=e^.attr^.ForStmt.size; 
      IF    e^.attr^.ForStmt.step>1  THEN ASM.CS2                  ( add,sz  ,  i(e^.attr^.ForStmt.step),Loc(AT0.Memory.loc)                                         ); 
      ELSIF e^.attr^.ForStmt.step<-1 THEN ASM.CS2                  ( sub,sz  ,  i(-e^.attr^.ForStmt.step),Loc(AT0.Memory.loc)                                        ); 
      ELSIF e^.attr^.ForStmt.step=-1 THEN ASM.CS1                  ( dec,sz  ,  Loc(AT0.Memory.loc)                                                    ); 
                       ELSE ASM.CS1                  ( inc,sz  ,  Loc(AT0.Memory.loc)                                                    ); 
      END;          
      
      reg:=ASM.SizedRegTab[RegAlloc.allocation[1].scr[1],e^.attr^.ForStmt.size]; 
      ASM.Label                        ( e^.attr^.ForStmt.condLabel                                                                           ); 
      ASM.CS2                                        ( mov,sz  ,  oB(e^.attr^.ForStmt.tempOfs,ebp),R(reg)                                     );
      ASM.CS2                                        ( cmp,sz  ,  R(reg),Loc(AT0.Memory.loc)                                             );
      IF e^.attr^.ForStmt.step<0 THEN 
         ASM.C1                                      ( jge     ,  L(e^.attr^.ForStmt.loopLabel)                                               );
      ELSE 
         ASM.C1                                      ( jle     ,  L(e^.attr^.ForStmt.loopLabel)                                               );
      END; 
    
