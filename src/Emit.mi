      ASM.C1                                         ( jz      ,  L(LAB.New(label1))                                            );
      ASM.C1                                         ( pushl   ,  oL(-12,e^.attr^.RecordGuard.typeLabel)                                          );
      ASM.C1                                         ( pushl   ,  oB(-12,RegAlloc.allocation[ai].op[2])                                                     );
      ASM.C1                                         ( jmp     ,  L(LAB.GuardFault)                                             ); 
      ASM.Label                              ( label1                                                                           ); 
      DEC(AT0.Memory.loc.ofs,e^.attr^.RecordGuard.tagOfs); 
    
   | 69 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
  EmitNtaArguments(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
