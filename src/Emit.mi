 ASM.C1                                         ( pushl   ,  i(e^.attr^.OpenNew.nofLens)                                                 );
      ASM.C1                                         ( pushl   ,  iL(e^.attr^.OpenNew.initLabel)                                              );
      ASM.C1                                         ( pushl   ,  iL(e^.attr^.OpenNew.tdescLabel)                                             );
      ASM.C1                                         ( pushl   ,  i(e^.attr^.OpenNew.elemSize)                                                );
      ASM.CS2                                        ( lea,l   ,  Loc(AT1.Memory.loc),R(RegAlloc.allocation[1].scr[1])                                               );
