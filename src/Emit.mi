PROCEDURE EmitNtaLabel (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR

BEGIN
   CASE e^.gcg^.rule [ntaLabel] OF 
   | 100 : 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 100/1653 Cost=');
          WriteInt    (e^.gcg^.cost [ntaLabel],1);
          WriteString (' LabelDef ->   aLabel');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.Label                            ( e^.attr^.LabelDef.label                                                                           ); 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraLabel (resAttributes);
       WriteLn;
   END;
END EmitNtaLabel;

PROCEDURE EmitNtaCondition (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaCondition] OF 
   | 106 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 106/1700 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' ConstStringCompare ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.ConstStringCompare(e^.attr^.ConstStringCompare.str,RegAlloc.allocation[ai].op[2]); 
      resAttributes.aCondition.rel:=e^.attr^.ConstStringCompare.rel; 
    
   | 105 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
  EmitNtLReg(e^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 105/1682 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' StringCompare ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 r1:=ASM.LoRegTab[RegAlloc.allocation[ai].scr[1]]; r2:=ASM.HiRegTab[RegAlloc.allocation[ai].scr[1]]; 
      ASM.Label                      ( LAB.New(label1)                                                                          ); 
      ASM.CS2                                        ( mov,b   ,  B(esi),R(r1)                                                  ); 
      ASM.CS2                                        ( mov,b   ,  B(edi),R(r2)                                                  ); 
      ASM.CS2                                        ( cmp,b   ,  R(r2),R(r1)                                                   ); 
      ASM.C1                                         ( jnz     ,  L(LAB.New(label2))                                            );
      ASM.CS1                                        ( inc,l   ,  R(esi)                                                        );
      ASM.CS1                                        ( inc,l   ,  R(edi)                                                        );

      ASM.CS2                                        ( test,b  ,  R(r1),R(r2)                                                   ); 
      ASM.C1                                         ( jnz     ,  L(label1)                                                     );

      ASM.Label                              ( label2                                                                           ); 
      resAttributes.aCondition.rel:=e^.attr^.StringCompare.rel; 
    
   | 104 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtAImm(e^.son[2],nest+1,AT1 ); 
  EmitNtAMemAReg(e^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 104/1675 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' Compare ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( cmp,e^.son[2]^.gcg^.AImm.size  ,  Operand(AT1.AImm.oper),Operand(AT2.AMemAReg.oper)                     ); 
      resAttributes.aCondition.rel:=ASM.RevRelTab[e^.attr^.Compare.rel]; 
    
   | 103 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtAReg(e^.son[2],nest+1,AT1 ); 
  EmitNtAMemARegAImm(e^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 103/1669 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' Compare ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( cmp,e^.son[2]^.gcg^.AReg.size  ,  Operand(AT2.AMemARegAImm.oper),Operand(AT1.AReg.oper)                     ); 
      resAttributes.aCondition.rel:=e^.attr^.Compare.rel; 
    
   | 102 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtAMem(e^.son[2],nest+1,AT1 ); 
  EmitNtARegAImm(e^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 102/1663 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' Compare ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( cmp,e^.son[2]^.gcg^.AMem.size  ,  Operand(AT2.ARegAImm.oper),Operand(AT1.AMem.oper)                     ); 
      resAttributes.aCondition.rel:=e^.attr^.Compare.rel; 
    
   | 101 : 
  EmitNtaLabel(e^.son[1],nest+1,AT0 ); 
  EmitNtAMemAReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 101/1657 Cost=');
          WriteInt    (e^.gcg^.cost [ntaCondition],1);
          WriteString (' Flag ->   aCondition');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( test,b  ,  i(1),Operand(AT1.AMemAReg.oper)                                        ); 
      resAttributes.aCondition.rel:=e^.attr^.Flag.rel; 
    
   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttraCondition (resAttributes);
       WriteLn;
   END;
END EmitNtaCondition;

PROCEDURE EmitNtaBoolean (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntaBoolean] OF 
   | 358 : 
  EmitNtaLabel(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtAMem(e^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtFloat(e^.son[1]^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 358/3742 Cost=');
          WriteInt    (e^.gcg^.cost [ntaBoolean],1);
          WriteString (' Branch ->   aBoolean');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 oper:=ASM.BranchOperTab[ASM.InvRelTab[ASM.RevRelTab[e^.son[1]^.attr^.FloatCompare.rel]],(*isSignedRelation:=*)FALSE]; 
      NDP.CS1                                        ( fcomp,e^.son[1]^.son[2]^.gcg^.AMem.size    ,  Operand(AT1.AMem.oper)                                       );
      NDP.C1                                         ( fstsw           ,  R(ax)                                                 );
      ASM.C0                                         ( sahf                                                                     ); 
      ASM.C1                                         ( oper            ,  L(e^.attr^.Branch.falseLabel)                                      );
      ASM.C1                                         ( jmp             ,  L(e^.attr^.Branch.trueLabel)                                       );
    
   | 357 : 
  EmitNtaLabel(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtFloat(e^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtAMem(e^.son[1]^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 357/3729 Cost=');
          WriteInt    (e^.gcg^.cost [ntaBoolean],1);
          WriteString (' Branch ->   aBoolean');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 oper:=ASM.BranchOperTab[ASM.InvRelTab[e^.son[1]^.attr^.FloatCompare.rel],(*isSignedRelation:=*)FALSE]; 
      NDP.CS1                                        ( fcomp,e^.son[1]^.son[3]^.gcg^.AMem.size    ,  Operand(AT2.AMem.oper)                                       );
      NDP.C1                                         ( fstsw           ,  R(ax)                                                 );
      ASM.C0                                         ( sahf                                                                     ); 
      ASM.C1                                         ( oper            ,  L(e^.attr^.Branch.falseLabel)                                      );
      ASM.C1                                         ( jmp             ,  L(e^.attr^.Branch.trueLabel)                                       );
    
   | 335 : 
  EmitNtaLabel(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtFloat(e^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtFloat(e^.son[1]^.son[3],nest+1,AT2 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 335/3559 Cost=');
          WriteInt    (e^.gcg^.cost [ntaBoolean],1);
          WriteString (' Branch ->   aBoolean');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
