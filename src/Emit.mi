 resAttributes.Memory.loc:=AT0.Memory.loc;  
      INC(AT0.Memory.loc.ofs,e^.attr^.RecordGuard.tagOfs); 
      ASM.CS2                                        ( mov,l   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].op[2])                                               ); 
