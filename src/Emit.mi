       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 48/1152 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' AMemAImm ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( mov,l   ,  Operand(AT0.AMemAImm.oper),R(RegAlloc.allocation[ai].reg)                                          ); 
    
   | 44 : 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 44/1134 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' ConjureRegister ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;

   | 41 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 41/1104 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' OpenIndexOpenBase ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( mov,l   ,  oB(e^.attr^.OpenIndexOpenBase.tmpOfs,ebp),R(RegAlloc.allocation[ai].scr[1])                                      ); 
      ASM.CS2                                        ( imul,l  ,  oB(e^.attr^.OpenIndexOpenBase.lenOfs,RegAlloc.allocation[ai].scr[1]),R(RegAlloc.allocation[ai].op[1])                                    );
    
   | 40 : 
  EmitNtLReg(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 40/1092 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' OpenIndex ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( mov,l   ,  oB(e^.attr^.OpenIndex.tmpOfs,ebp),R(RegAlloc.allocation[ai].scr[1])                                      ); 
      ASM.CS2                                        ( imul,l  ,  oB(e^.attr^.OpenIndex.lenOfs,RegAlloc.allocation[ai].scr[1]),R(RegAlloc.allocation[ai].op[1])                                    );
      IF ARG.OptionIndexChecking THEN 
         ASM.CS2                                     ( cmp,l   ,  oB(e^.attr^.OpenIndex.lenOfs,RegAlloc.allocation[ai].scr[1]),R(RegAlloc.allocation[ai].op[2])                                        );
         ASM.C1                                      ( jae     ,  L(LAB.IndexFault)                                             );
      END;
      ASM.CS2                                        ( add,l   ,  R(RegAlloc.allocation[ai].op[2]),R(RegAlloc.allocation[ai].op[1])                                                 );
    
   | 39 : 
  EmitNtMemory(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 39/1075 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' OpenIndexFirst ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF ARG.OptionCommentsInAsm THEN 
         ASM.CmtS("First: displ="); 
         ASM.CmtR(RegAlloc.allocation[ai].op[2]); 
         ASM.CmtS(" tmpOfs="); 
         ASM.CmtI(e^.attr^.OpenIndexFirst.tmpOfs); 
      END; 
      ASM.CS2                                        ( lea,l   ,  Loc(AT0.Memory.loc),R(RegAlloc.allocation[ai].scr[1])                                             );
      ASM.CS2                                        ( mov,l   ,  R(RegAlloc.allocation[ai].scr[1]),oB(e^.attr^.OpenIndexFirst.tmpOfs,ebp)                                      ); 
      IF ARG.OptionIndexChecking THEN 
         ASM.CS2                                     ( cmp,l   ,  oB(e^.attr^.OpenIndexFirst.lenOfs,RegAlloc.allocation[ai].scr[1]),R(RegAlloc.allocation[ai].op[2])                                        );
         ASM.C1                                      ( jae     ,  L(LAB.IndexFault)                                             );
      END;
    
   | 37 : 
  EmitNtBregIreg(e,nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 37/1062 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' BregIreg ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  Loc(AT0.BregIreg.loc),R(RegAlloc.allocation[ai].reg)                                               ); 
    
   | 6 : 
  EmitNtReg(e,nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 6/959 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' Reg ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;

   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttrLReg (resAttributes);
       WriteLn;
   END;
   IF RegAlloc.allocation [ai].actionafter THEN  (* ++ he 08/91 *)
 ; 
      WITH RegAlloc.allocation[ai] DO 
         IF spilllocation#0 THEN 
            Spill (reg, spilllocation);
            IF IR.OptEmitMatch THEN 
                WriteString (' Spill Register ');
                PrintRegister (reg);
                WriteString (' into ');
                WriteInt (spilllocation,1);
                WriteLn;
            END;
         ELSE 
            LR (regmove, reg);
            IF IR.OptEmitMatch THEN 
                WriteString (' Copy Register ');
                PrintRegister (reg);
                WriteString (' into ');
                PrintRegister (regmove);
                WriteLn;
            END;
         END;   
      END;
   END;                                           (* -- he 08/91 *)
END EmitNtLReg;

PROCEDURE EmitNtReg (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntReg] OF 
   | 250 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 250/3178 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' ShiftOrRotate ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF ASMOP.IsRotateOper[e^.attr^.ShiftOrRotate.code] OR (ABS(e^.son[2]^.attr^.LongintConst.val)<ASM.BitSizeTab[ASM.RegSizeTab[RegAlloc.allocation[ai].op[1]]]) THEN 
         IF e^.son[2]^.attr^.LongintConst.val>0 THEN 
            ASM.CS2                                  ( e^.attr^.ShiftOrRotate.code,ASM.RegSizeTab[RegAlloc.allocation[ai].op[1]]  ,  i(e^.son[2]^.attr^.LongintConst.val),R(RegAlloc.allocation[ai].op[1])                           );
         ELSIF e^.son[2]^.attr^.LongintConst.val<0 THEN
            e^.attr^.ShiftOrRotate.code:=ASMOP.InvDirTab[e^.attr^.ShiftOrRotate.code]; 
            ASM.CS2                                  ( e^.attr^.ShiftOrRotate.code,ASM.RegSizeTab[RegAlloc.allocation[ai].op[1]]  ,  i(-e^.son[2]^.attr^.LongintConst.val),R(RegAlloc.allocation[ai].op[1])                          );
         END;
      ELSE 
         ASM.CS2                                     ( xor,ASM.RegSizeTab[RegAlloc.allocation[ai].op[1]]      ,  R(RegAlloc.allocation[ai].op[1]),R(RegAlloc.allocation[ai].op[1])                               );
      END;
    
   | 191 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 191/2390 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' ShortRangeCheck ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[1]^.gcg^.Reg.size=w THEN 
         ASM.CS2                                     ( cmp,w   ,  i( 127),R(RegAlloc.allocation[ai].op[1])                                                  ); 
         ASM.C1                                      ( jg      ,  L(LAB.ShortFault)                                             );
         ASM.CS2                                     ( cmp,w   ,  i(-128),R(RegAlloc.allocation[ai].op[1])                                                  ); 
         ASM.C1                                      ( jl      ,  L(LAB.ShortFault)                                             );
      ELSE 
         ASM.CS2                                     ( cmp,l   ,  i( 32767),R(RegAlloc.allocation[ai].op[1])                                                ); 
         ASM.C1                                      ( jg      ,  L(LAB.ShortFault)                                             );
         ASM.CS2                                     ( cmp,l   ,  i(-32768),R(RegAlloc.allocation[ai].op[1])                                                ); 
         ASM.C1                                      ( jl      ,  L(LAB.ShortFault)                                             );
      END; 
    
   | 190 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 190/2379 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' ChrRangeCheck ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[1]^.gcg^.Reg.size=b THEN 
         ASM.CS2                                     ( cmp,b       ,  i(7FH),R(RegAlloc.allocation[ai].op[1])                                               ); 
      ELSE 
         ASM.CS2                                     ( cmp,e^.son[1]^.gcg^.Reg.size  ,  i(0FFH),R(RegAlloc.allocation[ai].op[1])                                              ); 
      END;
      ASM.C1                                         ( ja          ,  L(LAB.ChrFault)                                           ); 
    
   | 189 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 189/2368 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' MinIntCheck ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 CASE e^.son[1]^.gcg^.Reg.size OF
      |b: ASM.CS2                                    ( cmp,b   ,  i(-128),R(RegAlloc.allocation[ai].op[1])                                                  ); 
      |w: ASM.CS2                                    ( cmp,w   ,  i(-32768),R(RegAlloc.allocation[ai].op[1])                                                ); 
      |l: ASM.CS2                                    ( cmp,l   ,  x(80000000H),R(RegAlloc.allocation[ai].op[1])                                             ); 
      END;
      ASM.C1                                         ( jz      ,  L(e^.attr^.MinIntCheck.faultLabel)                                              ); 
    
   | 128 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
  EmitNtReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 128/1911 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' ShiftOrRotate ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 s1:=ASM.RegSizeTab[RegAlloc.allocation[ai].op[1]]; s2:=ASM.RegSizeTab[RegAlloc.allocation[ai].op[2]]; 
      ASM.CS2                                        ( test,s2     ,  R(RegAlloc.allocation[ai].op[2]),R(RegAlloc.allocation[ai].op[2])                                               ); 
      ASM.C1                                         ( js          ,  L(LAB.New(label1))                                        );
      ASM.CS2                                        ( e^.attr^.ShiftOrRotate.code,s1  ,  R(cl),R(RegAlloc.allocation[ai].op[1])                                               );
      ASM.C1                                         ( jmp         ,  L(LAB.New(label2))                                        );
      ASM.Label                              ( label1                                                                           );
      ASM.CS1                                        ( neg,s2      ,  R(RegAlloc.allocation[ai].op[2])                                                     ); 
      e^.attr^.ShiftOrRotate.code:=ASMOP.InvDirTab[e^.attr^.ShiftOrRotate.code]; 
      ASM.CS2                                        ( e^.attr^.ShiftOrRotate.code,s1  ,  R(cl),R(RegAlloc.allocation[ai].op[1])                                               );
      ASM.Label                              ( label2                                                                           ); 
    
   | 122 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 122/1856 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' Abs ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( test,e^.son[1]^.gcg^.Reg.size  ,  R(RegAlloc.allocation[ai].op[1]),R(RegAlloc.allocation[ai].op[1])                                                ); 
      ASM.C1                                         ( jge          ,  L(LAB.New(label))                                        ); 
      ASM.CS1                                        ( neg,e^.son[1]^.gcg^.Reg.size   ,  R(RegAlloc.allocation[ai].op[1])                                                     ); 
      ASM.Label                               ( label                                                                           ); 
    
   | 83 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
  EmitNtAMemARegAImm(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 83/1495 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' Sub ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( sub,e^.son[1]^.gcg^.Reg.size  ,  Operand(AT1.AMemARegAImm.oper),R(RegAlloc.allocation[ai].op[1])                                   ); 
    
   | 82 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
  EmitNtAMemARegAImm(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 82/1488 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' SymDyOper ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( e^.attr^.SymDyOper.code,e^.son[1]^.gcg^.Reg.size  ,  Operand(AT1.AMemARegAImm.oper),R(RegAlloc.allocation[ai].op[1])                               ); 
    
   | 81 : 
  EmitNtAMemARegAImm(e^.son[1],nest+1,AT0 ); 
  EmitNtReg(e^.son[2],nest+1,AT1 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 81/1488 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' SymDyOper ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( e^.attr^.SymDyOper.code,e^.son[2]^.gcg^.Reg.size  ,  Operand(AT0.AMemARegAImm.oper),R(RegAlloc.allocation[ai].op[2])                               ); 
    
   | 80 : 
  EmitNtReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 80/1481 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' MonOper ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS1                                        ( e^.attr^.MonOper.code,e^.son[1]^.gcg^.Reg.size  ,  R(RegAlloc.allocation[ai].op[1])                                                  ); 
    
   | 3 : 
  EmitNtLReg(e,nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 3/955 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' LReg ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;

   | 2 : 
  EmitNtWReg(e,nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 2/954 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' WReg ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;

   | 1 : 
  EmitNtBReg(e,nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 1/953 Cost=');
          WriteInt    (e^.gcg^.cost [ntReg],1);
          WriteString (' BReg ->   Reg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;

   END;
   IF IR.OptEmitMatch THEN 
       WriteNest (nest);
       WriteAttrReg (resAttributes);
       WriteLn;
   END;
   IF RegAlloc.allocation [ai].actionafter THEN  (* ++ he 08/91 *)
 ; 
      WITH RegAlloc.allocation[ai] DO 
         IF spilllocation#0 THEN 
            Spill (reg, spilllocation);
            IF IR.OptEmitMatch THEN 
                WriteString (' Spill Register ');
                PrintRegister (reg);
                WriteString (' into ');
                WriteInt (spilllocation,1);
                WriteLn;
            END;
         ELSE 
            LR (regmove, reg);
            IF IR.OptEmitMatch THEN 
                WriteString (' Copy Register ');
                PrintRegister (reg);
                WriteString (' into ');
                PrintRegister (regmove);
                WriteLn;
            END;
         END;   
      END;
   END;                                           (* -- he 08/91 *)
END EmitNtReg;

PROCEDURE EmitNtFloat (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntFloat] OF 
   | 362 : 
  EmitNtAMem(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 362/3791 Cost=');
          WriteInt    (e^.gcg^.cost [ntFloat],1);
          WriteString (' Int2Float ->   Float');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 IF e^.son[1]^.gcg^.AMem.size=b THEN 
         ASM.C2                                      ( movsbl          ,  Operand(AT0.AMem.oper),R(RegAlloc.allocation[ai].scr[1])                                ); 
         ASM.C1                                      ( pushl           ,  R(RegAlloc.allocation[ai].scr[1])                                                ); 
         NDP.CS1                                     ( fild,l          ,  B(esp)                                                );
         ASM.CS2                                     ( add,l           ,  i(4),R(esp)                                           );
      ELSE 
         NDP.CS1                                     ( fild,e^.son[1]^.gcg^.AMem.size     ,  Operand(AT0.AMem.oper)                                       );
      END;
    
   | 361 : 
  EmitNtBReg(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
