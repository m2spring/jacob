      IF e^.attr^.FloatAssignment.size=l THEN
         INC(AT1.Memory.loc.ofs,4); INC(AT0.Memory.loc.ofs,4);
         ASM.CS2                                     ( mov,l           ,  Loc(AT1.Memory.loc),R(RegAlloc.allocation[1].scr[1])                                   ); 
         ASM.CS2                                     ( mov,l           ,  R(RegAlloc.allocation[1].scr[1]),Loc(AT0.Memory.loc)                                   ); 
      END;
    
    END;
  END;
END EmitStatement;

PROCEDURE EmitInstruction (e : IR.Expression);
BEGIN
   IF IR.OptEmitIR THEN IR.PrintExpression (e); END;
(******* empty insertion IpEmitI1 *******)
      localavail[0] := { ORD (Regal)-0,  ORD (Regah)-0,  ORD (Regbl)-0,  ORD (Regbh)-0,  ORD (Regcl)-0,  ORD (Regch)-0,  ORD (Regdl)-0,  ORD (Regdh)-0,  ORD (Regax)-0,  ORD (Regbx)-0,  ORD (Regcx)-0,  ORD (Regdx)-0,  ORD (Regsi)-0,  ORD (Regdi)-0,  ORD (Regeax)-0,  ORD (Regebx)-0,  ORD (Regecx)-0,  ORD (Regedx)-0,  ORD (Regesi)-0,  ORD (Regedi)-0,  ORD (Regebp)-0,  ORD (Regesp)-0,  ORD (Regst)-0,  ORD (Regst1)-0,  ORD (Regst2)-0,  ORD (Regst3)-0,  ORD (Regst4)-0,  ORD (Regst5)-0,  ORD (Regst6)-0,  ORD (Regst7)-0};
   RegAlloc.RegAllo (e, localavail);
(******* empty insertion IpEmitI2 *******)
   EmitStatement (e);
END EmitInstruction;
 VAR  RegisterSetEmpty : RegisterSet;
BEGIN
  RegisterSetEmpty [0] := {};
(******* empty insertion IpEmitInit *******)
END Emit.
