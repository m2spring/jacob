       WriteLn;
       WriteNest (nest); 
       IF e#NIL THEN IR.PrintAttributes (e^.attr^); END; WriteLn; 
       WriteNest (nest); 
       RegAlloc.PrintAllocation (1); WriteLn;
    END;
 reg:=ASM.SizedRegTab[RegAlloc.allocation[1].op[1],l]; 
      IF    e^.attr^.CaseExpr.isChar   THEN ASM.CS2                 ( and,l   ,  x(0FFH),R(reg)                                                ); 
      ELSIF e^.son[1]^.gcg^.Reg.size=b    THEN ASM.C2                  ( movsbl  ,  R(RegAlloc.allocation[1].op[1]),R(reg)                                                   );
      ELSIF RegAlloc.allocation[1].op[1]=ax        THEN ASM.C0                  ( cwde                                                                     );
      ELSIF e^.son[1]^.gcg^.Reg.size=w    THEN ASM.C2                  ( movswl  ,  R(RegAlloc.allocation[1].op[1]),R(reg)                                                   );
      END;                                               

      IF    e^.attr^.CaseExpr.minVal>0 THEN ASM.CS2                 ( sub,l   ,  i(e^.attr^.CaseExpr.minVal),R(reg)                                           ); 
      ELSIF e^.attr^.CaseExpr.minVal<0 THEN ASM.CS2                 ( add,l   ,  i(-e^.attr^.CaseExpr.minVal),R(reg)                                          ); 
      ELSIF ~e^.attr^.CaseExpr.isChar  THEN ASM.CS2                 ( test,l  ,  R(reg),R(reg)                                                 ); 
      END;
      ASM.C1                                         ( jl      ,  L(e^.attr^.CaseExpr.elseLabel)                                               );

      ASM.CS2                                        ( cmp,l   ,  i(e^.attr^.CaseExpr.maxVal-e^.attr^.CaseExpr.minVal),R(reg)                                 ); 
      ASM.C1                                         ( jg      ,  L(e^.attr^.CaseExpr.elseLabel)                                               );
      ASM.C1                                         ( jmp     ,  LIf(e^.attr^.CaseExpr.tabLabel,reg,4)                                        ); 
    
     | 79 :
