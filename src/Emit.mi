      INC(AT0.Memory.loc.ofs,e^.attr^.SimpleGuard.tagOfs); 
      ASM.CS2                                        ( cmp,l   ,  iL(e^.attr^.SimpleGuard.typeLabel),Loc(AT0.Memory.loc)                                   );
      ASM.C1                                         ( jz      ,  L(LAB.New(label1))                                            );
      ASM.C1                                         ( pushl   ,  oL(-12,e^.attr^.SimpleGuard.typeLabel)                                          );
      ASM.CS2                                        ( mov,l   ,  Loc(AT0.Memory.loc),R(eax)                                             );
      ASM.C1                                         ( pushl   ,  oB(-12,eax)                                                   );
      ASM.C1                                         ( jmp     ,  L(LAB.GuardFault)                                             ); 
      ASM.Label                              ( label1                                                                           ); 
    
   | 184 : 
