PROCEDURE EmitNtLReg (e : IR.Expression; nest : INTEGER
       ; VAR resAttributes : NtAttributes); 
VAR
    AT0   :  NtAttributes;
    AT1   :  NtAttributes;
    AT2   :  NtAttributes;
    AT3   :  NtAttributes;

BEGIN
   CASE e^.gcg^.rule [ntLReg] OF 
   | 339 : 
  EmitNtFloat(e^.son[1],nest+1,AT0 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 339/3604 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' Entier ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( sub,l         ,  i(4),R(esp)                                             );
      NDP.CS1                                        ( fistp,l       ,  B(esp)                                                  ); 
      ASM.C1                                         ( popl          ,  R(RegAlloc.allocation[ai].reg)                                                    );
    
   | 324 : 
  EmitNtConstant(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtLReg(e^.son[2]^.son[2]^.son[1],nest+1,AT2 ); 
  EmitNtConstant(e^.son[2]^.son[2]^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 324/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[1]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[2],RegAlloc.allocation[ai].op[3],e^.son[2]^.son[2]^.son[2]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 323 : 
  EmitNtConstant(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[2]^.son[2]^.son[1],nest+1,AT2 ); 
  EmitNtLReg(e^.son[2]^.son[2]^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 323/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[1]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[2],RegAlloc.allocation[ai].op[4],e^.son[2]^.son[2]^.son[1]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 322 : 
  EmitNtConstant(e^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[2]^.son[1]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[2]^.son[1]^.son[2],nest+1,AT2 ); 
  EmitNtLReg(e^.son[2]^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 322/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[1]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[4],RegAlloc.allocation[ai].op[2],e^.son[2]^.son[1]^.son[2]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 321 : 
  EmitNtConstant(e^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[2]^.son[1]^.son[1],nest+1,AT1 ); 
  EmitNtLReg(e^.son[2]^.son[1]^.son[2],nest+1,AT2 ); 
  EmitNtLReg(e^.son[2]^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 321/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[1]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[4],RegAlloc.allocation[ai].op[3],e^.son[2]^.son[1]^.son[1]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 320 : 
  EmitNtLReg(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtLReg(e^.son[1]^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtConstant(e^.son[1]^.son[2]^.son[2],nest+1,AT2 ); 
  EmitNtConstant(e^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 320/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[2]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[1],RegAlloc.allocation[ai].op[2],e^.son[1]^.son[2]^.son[2]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 319 : 
  EmitNtLReg(e^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[1]^.son[2]^.son[1],nest+1,AT1 ); 
  EmitNtLReg(e^.son[1]^.son[2]^.son[2],nest+1,AT2 ); 
  EmitNtConstant(e^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
       END;
       IF IR.OptEmitMatch THEN
          WriteNest (nest);
          WriteString ('Rule 319/3466 Cost=');
          WriteInt    (e^.gcg^.cost [ntLReg],1);
          WriteString (' SymDyOper ->   LReg');
          WriteLn;
          WriteNest (nest); 
          WriteCard (CARDINAL(e),1); Write(' ');
          IF e#NIL THEN IR.PrintAttributes (e^.attr^); ELSE WriteLn; END;
          WriteNest (nest); 
          RegAlloc.PrintAllocation (ai); 
       END;
 ASM.CS2                                        ( lea,l   ,  oBIf(e^.son[2]^.gcg^.Constant.val,RegAlloc.allocation[ai].op[1],RegAlloc.allocation[ai].op[3],e^.son[1]^.son[2]^.son[1]^.gcg^.Constant.val),R(RegAlloc.allocation[ai].reg)                                );
    
   | 318 : 
  EmitNtLReg(e^.son[1]^.son[1]^.son[1],nest+1,AT0 ); 
  EmitNtConstant(e^.son[1]^.son[1]^.son[2],nest+1,AT1 ); 
  EmitNtLReg(e^.son[1]^.son[2],nest+1,AT2 ); 
  EmitNtConstant(e^.son[2],nest+1,AT3 ); 
       ai:=ai-1;
       IF RegAlloc.allocation [ai]. num>0 THEN 
          PerformActions (ai);
