IMPLEMENTATION MODULE rMemory;

IMPORT Storage;
FROM SYSTEM IMPORT ADDRESS;

PROCEDURE Alloc (ByteCount: LONGINT) : ADDRESS;
VAR a : ADDRESS;
BEGIN
  Storage.ALLOCATE(a, ByteCount);
  RETURN a;
END Alloc;

PROCEDURE Free (ByteCount: LONGINT; a: ADDRESS);
BEGIN
  Storage.DEALLOCATE(a, ByteCount);
END Free;

END rMemory.
