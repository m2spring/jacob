   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opData2Retype;
   a^.Data2Retype.srcLen := AtsrcLen;
   a^.Data2Retype.dstLen := AtdstLen;
   a^.Data2Retype.tmpOfs := AttmpOfs;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 137/2136 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntReg];
   IF c <   ga^.cost[ntaRetype]  THEN 
 ga^.aRetype.dstLen:=e^.attr^.Data2Retype.dstLen; ga^.aRetype.tmpOfs:=e^.attr^.Data2Retype.tmpOfs; ;
     ga^.cost[ntaRetype] := c; 
     ga^.rule[ntaRetype] := 137;
   END;
     (* RULE 138/2146 *)
    c:=  2+     e^.son[1]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntaRetype]  THEN 
 ga^.aRetype.dstLen:=e^.attr^.Data2Retype.dstLen; ga^.aRetype.tmpOfs:=e^.attr^.Data2Retype.tmpOfs; ;
     ga^.cost[ntaRetype] := c; 
     ga^.rule[ntaRetype] := 138;
   END;
   MatchChainRules(e);
 END Data2Retype;


