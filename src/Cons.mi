 PROCEDURE  Retype2Data (
                         op1  : Retype
                      ;  VAR result : Data);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opRetype2Data;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 140/2168 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntaRetype];
   IF c <   ga^.cost[ntBReg]  THEN 
   IF  e^.son[1]^.gcg^.aRetype.dstLen=1  THEN 
     ga^.cost[ntBReg] := c; 
     ga^.rule[ntBReg] := 140;
   END;
   END;
     (* RULE 141/2173 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntaRetype];
   IF c <   ga^.cost[ntWReg]  THEN 
   IF  e^.son[1]^.gcg^.aRetype.dstLen=2  THEN 
     ga^.cost[ntWReg] := c; 
     ga^.rule[ntWReg] := 141;
   END;
   END;
     (* RULE 142/2178 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntaRetype];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  e^.son[1]^.gcg^.aRetype.dstLen=4  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 142;
   END;
   END;
     (* RULE 251/3194 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opData2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntReg];
   IF c <   ga^.cost[ntBReg]  THEN 
   IF  e^.son[1]^.attr^.Data2Retype.dstLen=1  THEN 
     ga^.cost[ntBReg] := c; 
     ga^.rule[ntBReg] := 251;
   END;
   END;
   END;
     (* RULE 252/3195 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opData2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntReg];
   IF c <   ga^.cost[ntWReg]  THEN 
   IF  e^.son[1]^.attr^.Data2Retype.dstLen=2  THEN 
     ga^.cost[ntWReg] := c; 
     ga^.rule[ntWReg] := 252;
   END;
   END;
   END;
     (* RULE 253/3196 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opData2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntReg];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  e^.son[1]^.attr^.Data2Retype.dstLen=4  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 253;
   END;
   END;
   END;
     (* RULE 254/3199 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opAddr2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntBReg]  THEN 
   IF  e^.son[1]^.attr^.Addr2Retype.dstLen=1  THEN 
     ga^.cost[ntBReg] := c; 
     ga^.rule[ntBReg] := 254;
   END;
   END;
   END;
     (* RULE 255/3207 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opAddr2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntWReg]  THEN 
   IF  e^.son[1]^.attr^.Addr2Retype.dstLen=2  THEN 
     ga^.cost[ntWReg] := c; 
     ga^.rule[ntWReg] := 255;
   END;
   END;
   END;
     (* RULE 256/3217 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opAddr2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  e^.son[1]^.attr^.Addr2Retype.dstLen=4  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 256;
   END;
   END;
   END;
   MatchChainRules(e);
 END Retype2Data;


 PROCEDURE  Retype2Float (
                         op1  : Retype
                      ;  VAR result : Data);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opRetype2Float;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 143/2183 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntaRetype];
   IF c <   ga^.cost[ntFloat]  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 143;
   END;
     (* RULE 257/3233 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opAddr2Retype THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntFloat]  THEN 
   IF  ((e^.son[1]^.attr^.Addr2Retype.dstLen=4) OR (e^.son[1]^.attr^.Addr2Retype.dstLen=8)) & (e^.son[1]^.attr^.Addr2Retype.dstLen<=e^.son[1]^.attr^.Addr2Retype.srcLen)  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 257;
   END;
   END;
   END;
   MatchChainRules(e);
 END Retype2Float;


