   END;
   MatchChainRules(e);
 END NoParam;


 PROCEDURE  Param (
                         op1  : Arguments
                      ;  op2  : Data
                      ;  VAR result : Arguments);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opParam;
   e^.arity := 2;
   e^.son[1] := op1;
   e^.son[2] := op2;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 51/1166 *)
    c:=  2+     e^.son[1]^.gcg^.cost[ntaArguments]+
     e^.son[2]^.gcg^.cost[ntAMemARegAImm];
   IF c <   ga^.cost[ntaArguments]  THEN 
     ga^.cost[ntaArguments] := c; 
     ga^.rule[ntaArguments] := 51;
   END;
     (* RULE 213/2627 *)
   e2 := e^.son[2];
   IF e2^.attr^.op = opAddressOf THEN 
    c:=  1+     e2^.son[1]^.gcg^.cost[ntGv];
    c:=  c+     e^.son[1]^.gcg^.cost[ntaArguments];
   IF c <   ga^.cost[ntaArguments]  THEN 
     ga^.cost[ntaArguments] := c; 
     ga^.rule[ntaArguments] := 213;
   END;
   END;
     (* RULE 214/2635 *)
   e2 := e^.son[2];
   IF e2^.attr^.op = opAddressOf THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opPointerFrom THEN 
   e4 := e3^.son[1];
   IF e4^.attr^.op = opContentOf THEN 
    c:=  1+     e4^.son[1]^.gcg^.cost[ntMemory];
    c:=  c+     e^.son[1]^.gcg^.cost[ntaArguments];
   IF c <   ga^.cost[ntaArguments]  THEN 
   IF  e^.son[2]^.son[1]^.son[1]^.attr^.ContentOf.size=l  THEN 
     ga^.cost[ntaArguments] := c; 
     ga^.rule[ntaArguments] := 214;
   END;
   END;
   END;
   END;
   END;
     (* RULE 215/2646 *)
   e2 := e^.son[2];
   IF e2^.attr^.op = opAddressOf THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opSelector THEN 
   e4 := e3^.son[1];
   IF e4^.attr^.op = opPointerFrom THEN 
   e5 := e4^.son[1];
   IF e5^.attr^.op = opContentOf THEN 
    c:=  1+     e5^.son[1]^.gcg^.cost[ntMemory];
    c:=  c+     e^.son[1]^.gcg^.cost[ntaArguments];
   IF c <   ga^.cost[ntaArguments]  THEN 
   IF  (e^.son[2]^.son[1]^.son[1]^.son[1]^.attr^.ContentOf.size=l) & (e^.son[2]^.son[1]^.attr^.Selector.ofs=0)  THEN 
     ga^.cost[ntaArguments] := c; 
     ga^.rule[ntaArguments] := 215;
   END;
   END;
   END;
   END;
   END;
   END;
   MatchChainRules(e);
 END Param;


