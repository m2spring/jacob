 PROCEDURE  FloatSymDyOper (
                      Atcode  :  ASMOP.tOper
                      ;  op1  : Data
                      ;  op2  : Data
                      ;  VAR result : Data);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opFloatSymDyOper;
   a^.FloatSymDyOper.code := Atcode;
   e^.arity := 2;
   e^.son[1] := op1;
   e^.son[2] := op2;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 332/3535 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntFloat]+
     e^.son[2]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntFloat]  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 332;
   END;
     (* RULE 349/3684 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntFloat]+
     e^.son[2]^.gcg^.cost[ntAMem];
   IF c <   ga^.cost[ntFloat]  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 349;
   END;
     (* RULE 350/3684 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntAMem]+
     e^.son[2]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntFloat]  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 350;
   END;
     (* RULE 353/3700 *)
   e2 := e^.son[2];
   IF e2^.attr^.op = opInt2Float THEN 
    c:=  1+     e2^.son[1]^.gcg^.cost[ntAMem];
    c:=  c+     e^.son[1]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntFloat]  THEN 
   IF  (e^.son[2]^.son[1]^.gcg^.AMem.size=w) OR (e^.son[2]^.son[1]^.gcg^.AMem.size=l)  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 353;
   END;
   END;
   END;
     (* RULE 354/3700 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opInt2Float THEN 
    c:=  1+     e2^.son[1]^.gcg^.cost[ntAMem];
    c:=  c+     e^.son[2]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntFloat]  THEN 
   IF  (e^.son[1]^.son[1]^.gcg^.AMem.size=w) OR (e^.son[1]^.son[1]^.gcg^.AMem.size=l)  THEN 
     ga^.cost[ntFloat] := c; 
     ga^.rule[ntFloat] := 354;
   END;
   END;
   END;
   MatchChainRules(e);
 END FloatSymDyOper;


