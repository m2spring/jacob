 PROCEDURE  Data2Retype (
                      AtsrcLen  :  LONGINT;
                      AtdstLen  :  LONGINT;
                      AttmpOfs  :  LONGINT
                      ;  op1  : Data
                      ;  VAR result : Retype);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
