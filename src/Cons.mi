 ga^.AVar.var.label    := e^.attr^.GlobalVariable.label; 
      ga^.AVar.var.frame    := 0;
      ga^.AVar.var.ofs      := e^.attr^.GlobalVariable.adr; 
      ga^.AVar.var.tmpreg   := RegNil; 
      ga^.AVar.var.cmtIdent := e^.attr^.GlobalVariable.cmtIdent; ;
     ga^.cost[ntAVar] := 0; 
     ga^.rule[ntAVar] := 297;
   END;
   MatchChainRules(e);
