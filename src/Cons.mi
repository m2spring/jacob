 PROCEDURE  OpenIndexApplication (
                      AtobjOfs  :  LONGINT;
                      AtisStackObj  :  BOOLEAN
                      ;  op1  : OpenIndexedElem
                      ;  VAR result : Address);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opOpenIndexApplication;
   a^.OpenIndexApplication.objOfs := AtobjOfs;
   a^.OpenIndexApplication.isStackObj := AtisStackObj;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 43/1119 *)
    c:=  1+     e^.son[1]^.gcg^.cost[ntaOpenIndexedElem];
   IF c <   ga^.cost[ntBregIreg]  THEN 
     ga^.cost[ntBregIreg] := c; 
     ga^.rule[ntBregIreg] := 43;
   END;
     (* RULE 211/2568 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opOpenIndexBase THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opOpenIndexFirst THEN 
    c:=  4+     e3^.son[1]^.gcg^.cost[ntMemory]+
     e3^.son[2]^.gcg^.cost[ntLReg];
    c:=  c+     e2^.son[2]^.gcg^.cost[ntLReg];
   IF c <   ga^.cost[ntBregIreg]  THEN 
     ga^.cost[ntBregIreg] := c; 
     ga^.rule[ntBregIreg] := 211;
   END;
   END;
   END;
     (* RULE 212/2599 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opOpenIndexBase THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opOpenIndexFirst THEN 
    c:=  3+     e3^.son[1]^.gcg^.cost[ntMemory]+
     e3^.son[2]^.gcg^.cost[ntConstant];
    c:=  c+     e2^.son[2]^.gcg^.cost[ntLReg];
   IF c <   ga^.cost[ntBregIreg]  THEN 
     ga^.cost[ntBregIreg] := c; 
     ga^.rule[ntBregIreg] := 212;
   END;
   END;
   END;
   MatchChainRules(e);
 END OpenIndexApplication;


