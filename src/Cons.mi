   END;
   END;
   END;
   END;
     (* RULE 300/3365 *)
    c:=       e^.son[1]^.gcg^.cost[ntAVar];
   IF c <   ga^.cost[ntAVar]  THEN 
 ga^.AVar.var:=e^.son[1]^.gcg^.AVar.var; INC(ga^.AVar.var.ofs,e^.attr^.Selector.ofs); ;
     ga^.cost[ntAVar] := c; 
     ga^.rule[ntAVar] := 300;
   END;
   MatchChainRules(e);
 END Selector;


