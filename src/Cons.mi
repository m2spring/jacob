   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 25/991 *)
   IF 0 <   ga^.cost[ntGv]  THEN 
     ga^.cost[ntGv] := 0; 
     ga^.rule[ntGv] := 25;
   END;
     (* RULE 297/3341 *)
