 PROCEDURE  ContentOf (
                      Atsize  :  tSize
                      ;  op1  : Address
                      ;  VAR result : Data);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opContentOf;
   a^.ContentOf.size := Atsize;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 45/1137 *)
    c:=       e^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntAMem]  THEN 
 ga^.AMem.size:=e^.attr^.ContentOf.size; ;
     ga^.cost[ntAMem] := c; 
     ga^.rule[ntAMem] := 45;
   END;
     (* RULE 295/3299 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opPointerFrom THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opPointerGuard THEN 
    c:=       e3^.son[1]^.gcg^.cost[ntMemory]+
     e3^.son[2]^.gcg^.cost[ntLReg]+
     e3^.son[3]^.gcg^.cost[ntLReg];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  e^.attr^.ContentOf.size=l  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 295;
   END;
   END;
   END;
   END;
   MatchChainRules(e);
 END ContentOf;


 PROCEDURE  AddressOf (
                         op1  : Address
                      ;  VAR result : Data);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
   IF NextAttr=NIL THEN MemExtend; END;
   e := NextExpr;
   a := NextAttr;
   ga  := NextGcg; e^.attr := a;
   NextAttr := NextAttr^.hashchain;
   NextExpr := NextExpr^.hashchain;
   NextGcg  := NextGcg^.hashchain; 
  a^.op := IR.opAddressOf;
   e^.arity := 1;
   e^.son[1] := op1;
   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 49/1158 *)
    c:=  2+     e^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntLReg]  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 49;
   END;
     (* RULE 216/2659 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opPointerFrom THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opContentOf THEN 
    c:=  2+     e3^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  e^.son[1]^.son[1]^.attr^.ContentOf.size=l  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 216;
   END;
   END;
   END;
   END;
     (* RULE 217/2667 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opSelector THEN 
   e3 := e2^.son[1];
   IF e3^.attr^.op = opPointerFrom THEN 
   e4 := e3^.son[1];
   IF e4^.attr^.op = opContentOf THEN 
    c:=  2+     e4^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntLReg]  THEN 
   IF  (e^.son[1]^.son[1]^.son[1]^.attr^.ContentOf.size=l) & (e^.son[1]^.attr^.Selector.ofs=0)  THEN 
     ga^.cost[ntLReg] := c; 
     ga^.rule[ntLReg] := 217;
   END;
   END;
   END;
   END;
   END;
   MatchChainRules(e);
 END AddressOf;


 PROCEDURE  NoParam (
                         VAR result : Arguments);
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
