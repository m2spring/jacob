   e3 := e2^.son[1];
   IF e3^.attr^.op = opFloatCompare THEN 
    c:=  4+     e3^.son[1]^.gcg^.cost[ntaLabel]+
     e3^.son[2]^.gcg^.cost[ntAMem]+
     e3^.son[3]^.gcg^.cost[ntFloat];
   IF c <   ga^.cost[ntBReg]  THEN 
     ga^.cost[ntBReg] := c; 
     ga^.rule[ntBReg] := 360;
   END;
   END;
   END;
   MatchChainRules(e);
 END BoolVal;


