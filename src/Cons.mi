   result := e;
   ga^.cost := IR.InfCosts;
   e^.gcg := ga;

     (* RULE 116/1803 *)
    c:=  5+     e^.son[1]^.gcg^.cost[ntLReg]+
     e^.son[2]^.gcg^.cost[ntLReg];
   IF c <   ga^.cost[ntaStrCopyArgs]  THEN 
     ga^.cost[ntaStrCopyArgs] := c; 
     ga^.rule[ntaStrCopyArgs] := 116;
   END;
     (* RULE 244/3074 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opImplicify THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   e2 := e^.son[2];
   IF e2^.attr^.op = opImplicify THEN 
    c:=  c+     e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntaStrCopyArgs]  THEN 
     ga^.cost[ntaStrCopyArgs] := c; 
     ga^.rule[ntaStrCopyArgs] := 244;
   END;
   END;
   END;
     (* RULE 245/3104 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opImplicifyConst THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   e2 := e^.son[2];
   IF e2^.attr^.op = opImplicify THEN 
    c:=  c+     e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntaStrCopyArgs]  THEN 
     ga^.cost[ntaStrCopyArgs] := c; 
     ga^.rule[ntaStrCopyArgs] := 245;
   END;
   END;
   END;
     (* RULE 246/3126 *)
   e2 := e^.son[1];
   IF e2^.attr^.op = opImplicify THEN 
    c:=       e2^.son[1]^.gcg^.cost[ntMemory];
   e2 := e^.son[2];
   IF e2^.attr^.op = opImplicifyConst THEN 
    c:=  c+     e2^.son[1]^.gcg^.cost[ntMemory];
   IF c <   ga^.cost[ntaStrCopyArgs]  THEN 
     ga^.cost[ntaStrCopyArgs] := c; 
     ga^.rule[ntaStrCopyArgs] := 246;
   END;
   END;
   END;
   MatchChainRules(e);
 END StrCopyArguments;


