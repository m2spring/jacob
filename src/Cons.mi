   e^.gcg := ga;

     (* RULE 27/1010 *)
    c:=       e^.son[1]^.gcg^.cost[ntGv];
   IF c <   ga^.cost[ntGv]  THEN 
     ga^.cost[ntGv] := c; 
     ga^.rule[ntGv] := 27;
   END;
     (* RULE 28/1013 *)
    c:=       e^.son[1]^.gcg^.cost[ntIreg];
   IF c <   ga^.cost[ntIreg]  THEN 
     ga^.cost[ntIreg] := c; 
     ga^.rule[ntIreg] := 28;
   END;
     (* RULE 29/1016 *)
    c:=       e^.son[1]^.gcg^.cost[ntBreg];
