 PROCEDURE  FloatAssignment (
                      Atsize  :  tSize
                      ;  op1  : Address
                      ;  op2  : Data
                                                         );
 VAR    e  : IR.Expression;
        a  : IR.Attributes;
        ga : IR.ExprAttributes;
        c  : INTEGER;
        e2,e3,e4,e5,e6,e7,e8,e9,e10 : IR.Expression;

 BEGIN
