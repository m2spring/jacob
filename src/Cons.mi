    c:=       e^.son[1]^.gcg^.cost[ntConstant];
   IF c <   ga^.cost[ntConstant]  THEN 
 ga^.Constant.size:=l; ga^.Constant.val:=e^.son[1]^.gcg^.Constant.val; ;
     ga^.cost[ntConstant] := c; 
     ga^.rule[ntConstant] := 266;
   END;
   MatchChainRules(e);
 END Int2Longint;


