#!/bin/sh

SYSDIR=$(cd "$(dirname "$0")/../src" && pwd)

case $1 in
'-elf' ) shift ;;
esac;

RTS="$SYSDIR/OB2RTS-elf.o $SYSDIR/Storage-elf.o $SYSDIR/UTIS-elf.o"

case $1 in
'-static' ) STAT='-static' ; shift ;;
*         ) STAT='' ;;
esac;

PROGRAM=$1 ; shift ; OBJECTS=$*
# None of Jacob's generated .s (or Mocka-era runtime .s) files carry a
# .note.GNU-stack section -- they predate the convention -- so ld warns
# and falls back to assuming an executable stack. Nothing here actually
# needs one; tell the linker explicitly instead of relying on that
# (deprecated) fallback.
gcc -m32 -no-pie -Wl,-z,noexecstack -o $PROGRAM $STAT $RTS $OBJECTS -lc
chmod 770 $PROGRAM
