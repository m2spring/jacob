#!/bin/sh

SYSDIR=/home/mspring/prj/jacob/jacob/src

case $1 in
'-elf' ) shift ;;
esac;

RTS="$SYSDIR/OB2RTS-elf.o $SYSDIR/Storage-elf.o $SYSDIR/UTIS-elf.o"

case $1 in
'-static' ) STAT='-static' ; shift ;;
*         ) STAT='' ;;
esac;

PROGRAM=$1 ; shift ; OBJECTS=$*
gcc -m32 -no-pie -o $PROGRAM $STAT $RTS $OBJECTS -lc
chmod 770 $PROGRAM
