#!/bin/sh
# Minimal hand-written configure script, not GNU Autoconf/Automake (this
# repo doesn't use the real Autotools, just their `./configure` convention).
# Locates the MOCKA and cocktail toolchains and writes their paths to
# config.mk, which build.sh reads instead of hardcoding them.
set -e

HOME_DIR=$(cd "$(dirname "$0")" && pwd)
PARENT_DIR=$(dirname "$HOME_DIR")

MOCKA="$PARENT_DIR/MOCKA/ver1807/bin"
COCKTAIL="$PARENT_DIR/cocktail/bin"

for arg in "$@"; do
    case "$arg" in
        --mocka=*) MOCKA="${arg#--mocka=}" ;;
        --cocktail=*) COCKTAIL="${arg#--cocktail=}" ;;
        --help)
            cat <<EOF
Usage: ./configure [--mocka=PATH] [--cocktail=PATH]

Locates the MOCKA and cocktail toolchains (see README.md Prerequisites)
and writes their paths to config.mk for build.sh to use.

Defaults, assuming siblings of this repo:
  --mocka=$PARENT_DIR/MOCKA/ver1807/bin
  --cocktail=$PARENT_DIR/cocktail/bin
EOF
            exit 0
            ;;
        *)
            echo "configure: unknown option '$arg'" >&2
            exit 1
            ;;
    esac
done

if [ ! -x "$MOCKA/Mocka" ]; then
    echo "configure: error: no Mocka binary at $MOCKA/Mocka" >&2
    echo "  clone https://github.com/trijezdci/MOCKA as '../MOCKA' next to this repo," >&2
    echo "  or pass --mocka=PATH. See README.md Prerequisites." >&2
    exit 1
fi

if [ ! -x "$COCKTAIL/puma" ]; then
    echo "configure: error: no puma binary at $COCKTAIL/puma" >&2
    echo "  clone https://github.com/cocolab8/cocktail as '../cocktail' next to this" >&2
    echo "  repo and run 'make install DIR=\$(pwd)' there, or pass --cocktail=PATH." >&2
    echo "  See README.md Prerequisites." >&2
    exit 1
fi

cat > "$HOME_DIR/config.mk" <<EOF
# Generated by ./configure. Do not edit; re-run ./configure instead.
HOME_DIR=$HOME_DIR
COCKTAIL=$COCKTAIL
MOCKA=$MOCKA
EOF

echo "==> Wrote config.mk"
echo "      MOCKA=$MOCKA"
echo "      COCKTAIL=$COCKTAIL"
